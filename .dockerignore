# CP2: file này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# VCS
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần khi chạy
tests
screenshots
solution
*.md
*.log
.idea
.vscode
.DS_Store
Thumbs.db
